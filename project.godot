; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Node",
"class": "JSONBeautifier",
"language": "GDScript",
"path": "res://addons/json_beautifier/json_beautifier.gd"
}, {
"base": "Node",
"class": "Persistence",
"language": "GDScript",
"path": "res://addons/PersistenceNode/persistence_node.gd"
}, {
"base": "Node",
"class": "QuizDynamic",
"language": "GDScript",
"path": "res://Scripts/QuizDynamic.gd"
} ]
_global_script_class_icons={
"JSONBeautifier": "",
"Persistence": "res://addons/PersistenceNode/icon.png",
"QuizDynamic": ""
}

[application]

config/name="Proyecto Final de Carrera"
run/main_scene="res://Scenes/Menu.tscn"
config/icon="res://icon.png"

[autoload]

Global="*res://Scripts/Global.gd"

[display]

window/size/resizable=false

[editor_plugins]

enabled=PoolStringArray( "res://addons/PersistenceNode/plugin.cfg" )

