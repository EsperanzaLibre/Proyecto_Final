[sub_resource type="RectangleShape2D" id=52]
extents = Vector2( 6155.25, 25 )

[sub_resource type="Shader" id=38]
code = "shader_type canvas_item; 
render_mode unshaded;

uniform vec2 scale;
uniform float zoom;

uniform vec4 water_color : hint_color;
uniform sampler2D noise;
uniform vec2 distortion_scale;
uniform float intensity;
uniform float speed;

void fragment() { 

float distortion = texture(noise, UV * scale * distortion_scale * TIME * speed ).x;
distortion -= 0.5;
	
float uv_h = SCREEN_PIXEL_SIZE.y / TEXTURE_PIXEL_SIZE.y;
vec2 reflec = vec2(SCREEN_UV.x - distortion * intensity , SCREEN_UV.y + uv_h * UV.y * scale.y * zoom *  2.0);

vec4 reflection = texture(SCREEN_TEXTURE, reflec);

COLOR.rgb = mix(reflection.rgb, water_color.rgb, water_color.a);

}"

